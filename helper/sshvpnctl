#!/usr/bin/env python3
"""Root-owned, narrowly scoped account helper. Only JSON arrives on stdin."""
import grp
import json
import os
import pwd
import spwd
import subprocess
import sys
import time

from sshvpn_policy import (
    GROUP, POLICY_DIR, USERNAME, lease_path, policy_path, read_policy,
    seed_legacy_accounts, write_policy,
)


ALLOWED = {"create", "disable", "enable", "delete", "password"}


def fail(message):
    print(message, file=sys.stderr)
    return 1


def run(*args, input_text=None, ok=(0,)):
    result = subprocess.run(args, input=input_text, text=True, capture_output=True, timeout=15)
    if result.returncode not in ok:
        raise RuntimeError(f"System command failed: {args[0]}")


def set_password(username, password):
    result = subprocess.run(
        ["/usr/bin/openssl", "passwd", "-6", "-stdin"], input=password + "\n",
        text=True, capture_output=True, timeout=15,
    )
    if result.returncode != 0 or not result.stdout.startswith("$6$"):
        raise RuntimeError("Password hashing failed.")
    run("/usr/sbin/usermod", "--password", result.stdout.strip(), username)


def verify_ssh_policy(username):
    result = subprocess.run(
        ["/usr/sbin/sshd", "-T", "-C", f"user={username},host=localhost,addr=127.0.0.1"],
        text=True, capture_output=True, timeout=15,
    )
    if result.returncode != 0:
        raise RuntimeError("Could not verify the main SSH configuration.")
    lines = set(result.stdout.splitlines())
    required = {
        "maxsessions 0", "allowtcpforwarding local", "permittty no",
        "forcecommand /usr/sbin/nologin", "passwordauthentication yes",
        "pubkeyauthentication no",
    }
    if not required.issubset(lines) or any(
        line.startswith("denygroups ") and GROUP in line.split()[1:]
        for line in lines
    ):
        raise RuntimeError("VPN account restrictions are not active on the main SSH port.")


def managed_user(username, group_id):
    try:
        user = pwd.getpwnam(username)
    except KeyError as exc:
        raise ValueError("Account does not exist.") from exc
    if user.pw_gid != group_id:
        raise ValueError("Account is not managed by this panel.")
    return user


def stop_user_processes(username):
    run("/usr/bin/pkill", "-KILL", "-u", username, ok=(0, 1))
    for _ in range(30):
        result = subprocess.run(
            ["/usr/bin/pgrep", "-u", username], capture_output=True, timeout=3,
        )
        if result.returncode == 1:
            return
        if result.returncode != 0:
            raise RuntimeError("Could not inspect account processes.")
        time.sleep(0.1)
    raise RuntimeError("Account processes are still running; retry deletion.")


def sweep_expired_accounts():
    if not POLICY_DIR.exists():
        return
    for path in POLICY_DIR.glob("*.json"):
        username = path.stem
        if not USERNAME.fullmatch(username):
            continue
        try:
            managed_user(username, grp.getgrnam(GROUP).gr_gid)
            policy = read_policy(username)
        except (KeyError, ValueError, FileNotFoundError):
            continue
        if policy["expires_at"] is not None and time.time() >= policy["expires_at"]:
            if not spwd.getspnam(username).sp_pwdp.startswith("!"):
                run("/usr/sbin/usermod", "--lock", username)
            run("/usr/bin/pkill", "-KILL", "-u", username, ok=(0, 1))


def disconnect_all_accounts():
    group_id = grp.getgrnam(GROUP).gr_gid
    for account in pwd.getpwall():
        if account.pw_gid == group_id:
            run("/usr/bin/pkill", "-KILL", "-u", account.pw_name, ok=(0, 1))


def main():
    if os.geteuid() != 0:
        return fail("Root privileges are required.")
    if len(sys.argv) != 2 or sys.argv[1] not in ALLOWED | {"seed-legacy", "sweep", "disconnect-all"}:
        return fail("Invalid action.")
    try:
        if sys.argv[1] == "seed-legacy":
            seed_legacy_accounts()
            return 0
        if sys.argv[1] == "sweep":
            sweep_expired_accounts()
            return 0
        if sys.argv[1] == "disconnect-all":
            disconnect_all_accounts()
            return 0
        body = sys.stdin.read(4097)
        if len(body) > 4096:
            raise ValueError("Request is too large.")
        request = json.loads(body)
        username = request["username"]
        if not isinstance(username, str) or not USERNAME.fullmatch(username):
            raise ValueError("Invalid username.")
        group_id = grp.getgrnam(GROUP).gr_gid
        action = sys.argv[1]
        if action in {"create", "password"}:
            password = request["password"]
            if not isinstance(password, str) or not 1 <= len(password) <= 256 or any(c in password for c in "\n\r\x00"):
                raise ValueError("Invalid password.")
        if action == "create":
            expires_at = request["expires_at"]
            max_connections = request["max_connections"]
            if type(expires_at) is not int or expires_at <= int(time.time()):
                raise ValueError("Expiry must be in the future.")
            if type(max_connections) is not int or not 1 <= max_connections <= 10000:
                raise ValueError("Invalid connection limit.")
            try:
                pwd.getpwnam(username)
            except KeyError:
                pass
            else:
                raise ValueError("Account already exists.")
            run("/usr/sbin/useradd", "--no-create-home", "--home-dir", "/var/empty", "--shell", "/usr/sbin/nologin", "--gid", GROUP, username)
            try:
                verify_ssh_policy(username)
                set_password(username, password)
                write_policy(username, expires_at, max_connections)
            except Exception:
                run("/usr/sbin/userdel", username)
                raise
        else:
            managed_user(username, group_id)
            if action == "disable":
                run("/usr/sbin/usermod", "--lock", username)
                run("/usr/bin/pkill", "-u", username, ok=(0, 1))
            elif action == "enable":
                policy = read_policy(username)
                if policy["expires_at"] is not None and time.time() >= policy["expires_at"]:
                    raise ValueError("This account has expired.")
                run("/usr/sbin/usermod", "--unlock", username)
            elif action == "password":
                was_locked = spwd.getspnam(username).sp_pwdp.startswith("!")
                set_password(username, password)
                if was_locked:
                    run("/usr/sbin/usermod", "--lock", username)
                run("/usr/bin/pkill", "-u", username, ok=(0, 1))
            elif action == "delete":
                run("/usr/sbin/usermod", "--lock", username)
                stop_user_processes(username)
                run("/usr/sbin/userdel", username)
                policy_path(username).unlink(missing_ok=True)
                lease_path(username).unlink(missing_ok=True)
    except (ValueError, KeyError, OSError, json.JSONDecodeError, RuntimeError, subprocess.TimeoutExpired) as exc:
        return fail(str(exc))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
